<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>local.telegram-chat-collector-backup</string>
<key>ProgramArguments</key><array>
<string>/ABSOLUTE/PATH/telegram-chat-collector/.venv/bin/python</string>
<string>-m</string><string>collector</string><string>--config</string>
<string>/ABSOLUTE/PATH/telegram-chat-collector/config.json</string>
<string>maintenance</string><string>--astrbot-root</string><string>/ABSOLUTE/PATH/AstrBot</string>
</array>
<key>WorkingDirectory</key><string>/ABSOLUTE/PATH/telegram-chat-collector</string>
<key>StartCalendarInterval</key><dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>15</integer></dict>
<key>StandardOutPath</key><string>/dev/null</string>
<key>StandardErrorPath</key><string>/ABSOLUTE/PATH/telegram-chat-collector/var/service-error.log</string>
</dict></plist>
