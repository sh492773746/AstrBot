<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>local.telegram-chat-collector</string>
  <key>ProgramArguments</key>
  <array>
    <string>/ABSOLUTE/PATH/telegram-chat-collector/.venv/bin/python</string>
    <string>-m</string><string>collector</string>
    <string>--config</string><string>/ABSOLUTE/PATH/telegram-chat-collector/config.json</string>
    <string>run</string>
  </array>
  <key>WorkingDirectory</key><string>/ABSOLUTE/PATH/telegram-chat-collector</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>/ABSOLUTE/PATH/telegram-chat-collector/var/service.log</string>
  <key>StandardErrorPath</key><string>/ABSOLUTE/PATH/telegram-chat-collector/var/service-error.log</string>
</dict>
</plist>
